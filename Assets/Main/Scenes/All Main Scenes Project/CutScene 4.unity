  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "THE END\n\nThank you for joining us on this unforgettable adventure.\n\nEvery
    step, every challenge, and every victory has brought us to this final moment.\n\nAlthough
    this journey has reached its ending, every ending is also the beginning of a
    new story.\n\nDEVELOPMENT TEAM\n\nThis game was created through the creativity,
    dedication, and teamwork of our development team.\n\nFrom the first idea to the
    final version, we worked together, shared our knowledge, and overcame many challenges.\n\nEvery
    mistake became a valuable lesson.\n\nEvery improvement brought us closer to completing
    this adventure.\n\nWe are proud to present the members who made this project
    possible:\n\nPS41039 \u2013 TA THANH MANH\n\nPS40378 \u2013 NGO TRUONG XUAN\n\nPS45677
    \u2013 NGUYEN TRUNG NGUYEN\n\nPS41465 \u2013 VU NGOC THANH TUNG\n\nBUILT WITH\n\nUnity
    Engine\n\nVisual Studio\n\nGit\n\nSPECIAL THANKS\n\nTo our families,\n\nThank
    you for your endless love, patience, and support.\n\nTo our friends,\n\nThank
    you for every suggestion, conversation, and moment of encouragement.\n\nTo the
    Unity community,\n\nThank you for sharing your knowledge and inspiring developers
    around the world.\n\nTo every artist, musician, and creator,\n\nYour amazing
    work inspired many ideas throughout this project.\n\nAnd finally, to every player,\n\nThank
    you for choosing to experience our game.\n\nEvery challenge you overcame and
    every decision you made became part of this story.\n\nA FINAL MESSAGE\n\nThis
    game was created with passion, determination, and countless hours of learning.\n\nThe
    journey was not always easy, but every challenge made this achievement more meaningful.\n\nNever
    stop creating.\n\nNever stop exploring.\n\nNever stop believing in your dreams.\n\nTHANK
    YOU FOR PLAYING\n\nWe hope this adventure brought you happiness, excitement,
    and unforgettable memories.\n\nMay your future adventures be even greater.\n\nSee
    you again.\n\nTHE END\n\nCopyright \xA9 2026 Animal Party Development Team\n\nAll
    Rights Reserved"
